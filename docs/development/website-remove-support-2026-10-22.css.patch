+/* Homepage introduction: product, actions, then compatibility. */
+.control-panel { justify-content: flex-start; }
+.control-panel .product-intro { margin-top: 24px; padding-bottom: 0; border-bottom: 0; }
+.control-panel .product-icon { width: 52px; height: 52px; border-radius: 16px; }
+.control-panel .product-name-row strong { font-size: 1.9rem; }
+.product-overview { flex: 1 0 auto; display: flex; flex-direction: column; justify-content: center; margin: 32px 0 24px; }
+.product-overview h2 { max-width: 15em; font-size: 1.75rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.035em; text-wrap: balance; }
+.product-overview p { margin-top: 12px; font-size: 0.9rem; line-height: 1.65; color: rgba(17, 17, 17, 0.65); text-wrap: pretty; }
+.capability-list { display: grid; gap: 16px; list-style: none; padding: 22px 0; border-block: 1px solid rgba(17, 17, 17, 0.09); }
+.capability-list li { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; gap: 20px; font-size: 0.84rem; line-height: 1.5; }
+.capability-list strong { font-weight: 600; }
+.capability-list span { color: rgba(17, 17, 17, 0.63); text-align: right; text-wrap: pretty; }
+.download-section { flex: 1 0 auto; display: flex; flex-direction: column; justify-content: center; margin-top: 28px; }
+.free-note { margin-bottom: 12px; font-size: 0.8rem; line-height: 1.55; color: rgba(17, 17, 17, 0.65); }
+.platform-note { display: flex; justify-content: center; gap: 8px; margin-top: 12px; font-size: 0.7rem; letter-spacing: 0.03em; line-height: 1.5; color: rgba(17, 17, 17, 0.6); }
+.compatibility-note { margin-top: 28px; padding-top: 22px; border-top: 1px solid rgba(17, 17, 17, 0.09); }
+.compatibility-note h3 { font-size: 0.83rem; line-height: 1.5; font-weight: 600; }
+.compatibility-note > p { margin-top: 7px; color: rgba(17, 17, 17, 0.63); font-size: 0.8rem; line-height: 1.65; text-wrap: pretty; }
+.compatibility-details { margin-top: 16px; font-size: 0.78rem; line-height: 1.6; }
+.compatibility-details summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; list-style: none; cursor: pointer; padding-block: 8px; }
+.compatibility-details summary::-webkit-details-marker { display: none; }
+.compatibility-details summary::after { content: "+"; font-size: 1rem; line-height: 1; }
+.compatibility-details[open] summary::after { content: "−"; }
+.compatibility-content { display: grid; gap: 12px; padding-top: 8px; color: rgba(17, 17, 17, 0.65); }
+.compatibility-content a { width: fit-content; color: var(--text-ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(17, 17, 17, 0.3); }
+.compatibility-content a:hover { text-decoration-color: currentColor; }
+.cta-button:focus-visible, .compatibility-details summary:focus-visible { outline: 2px solid var(--text-ink); outline-offset: 4px; }
+.control-panel .build-tag { margin-top: auto; padding-top: 24px; }
+@media (max-width: 819px) {
+  .product-overview { flex-grow: 0; margin-top: 28px; }
+  .download-section { flex-grow: 0; }
+  .control-panel .build-tag { margin-top: 16px; padding-top: 0; text-align: left; }
+}
+@media (max-width: 360px) {
+  .product-overview h2 { font-size: 1.6rem; }
+  .capability-list li { gap: 14px; font-size: 0.8rem; }
+}
