+/* First-screen product sheet: one reading edge and three coherent groups. */
+.control-panel {
+  --text-ink-muted: #66635c;
+  --control-border: #878279;
+  --action-hover: #33312d;
+  display: grid;
+  grid-template-rows: auto minmax(min-content, 1fr) auto;
+  gap: 40px;
+  inline-size: clamp(25rem, 34vw, 32rem);
+  width: clamp(25rem, 34vw, 32rem);
+  min-inline-size: 0;
+  padding: 36px clamp(28px, 2.5vw, 40px) 28px;
+  background: var(--panel-paper);
+  justify-content: normal;
+}
+
+.panel-topbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 16px;
+  min-inline-size: 0;
+}
+
+.panel-brand {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-inline-size: 0;
+  max-inline-size: 100%;
+}
+
+.panel-brand img { flex: none; border-radius: 12px; }
+.panel-brand strong {
