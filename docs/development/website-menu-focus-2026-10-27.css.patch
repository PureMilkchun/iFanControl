+@media (max-width:819px) { .tour-menu-layout { grid-template-columns: minmax(0,1fr); gap: 32px; } .tour-menu-layout > .tour-figure { grid-column: auto; grid-row: auto; } }
+
+#app-tour .tour-section :is(a, button):focus-visible { outline-color: var(--tour-fg); }
+
+.tour-figure-startup img { border-radius: 4.3% / 10.3%; }
